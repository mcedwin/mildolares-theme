# Copia este archivo como .env y completa los valores.
# El archivo .env esta en .gitignore y bloqueado por el .htaccess del tema.
# Si el servidor no respeta .htaccess, define las constantes en wp-config.php:
#   define( 'MIL_AI_API_KEY', 'sk-...' );

MIL_AI_API_KEY=

# Endpoint compatible con OpenAI (Chat Completions + Images).
MIL_AI_BASE_URL=https://api.openai.com/v1

MIL_AI_TEXT_MODEL=gpt-4o-mini
MIL_AI_IMAGE_MODEL=gpt-image-1

# Opcional: solo si tu cuenta lo requiere.
MIL_AI_ORG=
MIL_AI_PROJECT=

# Opcional: clave de https://www.pexels.com/api/ para imagenes de portada.
# No es obligatoria: sin clave se usan Openverse y Wikimedia Commons
# (ambos sin clave, licencias libres con atribucion).
MIL_PEXELS_API_KEY=
