# Prohibir acceso directo a archivos sensibles del tema.
<IfModule mod_authz_core.c>
    <FilesMatch "^\.env(\.|$)">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>
</IfModule>

<FilesMatch "\.(env|ini|log|json|ya?ml|md|sql|bak|dist|map)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(env|git|svn|hg)/" - [F,L]
</IfModule>

Options -Indexes
